
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Validade de Estoque - Transpetro</title>
    <!-- Importando a biblioteca jsPDF para gerar o PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            background: #ffffff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            margin: auto;
        }
        h2 {
            text-align: center;
            color: #333;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }
        input[type="date"], input[type="number"], select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        .inline-group {
            display: flex;
            gap: 10px;
        }
        .inline-group input {
            flex: 2;
        }
        .inline-group select {
            flex: 1;
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
        }
        button:hover {
            background-color: #0056b3;
        }
        #resultado {
            margin-top: 20px;
            padding: 15px;
            border-radius: 4px;
            text-align: center;
            font-weight: bold;
            font-size: 16px;
            display: none;
        }
        .verde {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .vermelho {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        #btnPdfContainer {
            margin-top: 15px;
            display: none;
        }
        .btn-pdf {
            background-color: #dc3545;
        }
        .btn-pdf:hover {
            background-color: #bd2130;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Validação de Materiais de Estoque</h2>
    
    <div class="form-group">
        <label for="dataFabricacao">Data de Fabricação:</label>
        <input type="date" id="dataFabricacao">
    </div>

    <div class="form-group">
        <label>Tempo de Validade do Material:</label>
        <div class="inline-group">
            <input type="number" id="tempoValidade" placeholder="Ex: 5" min="1">
            <select id="tipoTempo">
                <option value="anos">Anos</option>
                <option value="meses">Meses</option>
                <option value="dias">Dias</option>
            </select>
        </div>
    </div>

    <button onclick="calcularValidade()">Calcular Validade</button>

    <div id="resultado"></div>

    <div id="btnPdfContainer">
        <button class="btn-pdf" onclick="gerarPDF()">Gerar PDF de Recusa</button>
    </div>
</div>

<script>
    function calcularValidade() {
        const fabInput = document.getElementById('dataFabricacao').value;
        const tempoValor = parseInt(document.getElementById('tempoValidade').value);
        const tipoTempo = document.getElementById('tipoTempo').value;
        const resultadoDiv = document.getElementById('resultado');
        const btnPdfContainer = document.getElementById('btnPdfContainer');

        if (!fabInput || isNaN(tempoValor) || tempoValor <= 0) {
            alert('Por favor, preencha a data de fabricação e um tempo de validade válido.');
            return;
        }

        const dataFabricacao = new Date(fabInput + 'T00:00:00');
        
        // Pega a data atual do sistema (zerando as horas para comparar corretamente)
        const dataAtual = new Date();
        dataAtual.setHours(0, 0, 0, 0);

        if (dataAtual < dataFabricacao) {
            alert('A data de fabricação não pode ser posterior à data atual.');
            return;
        }

        // Calcula a data de validade final com base no tempo informado
        let dataValidade = new Date(dataFabricacao.getTime());
        if (tipoTempo === 'anos') {
            dataValidade.setFullYear(dataValidade.getFullYear() + tempoValor);
        } else if (tipoTempo === 'meses') {
            dataValidade.setMonth(dataValidade.getMonth() + tempoValor);
        } else if (tipoTempo === 'dias') {
            dataValidade.setDate(dataValidade.getDate() + tempoValor);
        }

        // Tempo total de vida útil em milissegundos
        const vidaUtilTotal = dataValidade - dataFabricacao;
        
        // Tempo restante a partir de hoje até a validade final
        const vidaUtilRestante = dataValidade - dataAtual;

        // Se o material já estiver vencido
        if (vidaUtilRestante <= 0) {
            resultadoDiv.className = 'vermelho';
            resultadoDiv.innerHTML = 'Material Vencido! Recusar material.';
            resultadoDiv.style.display = 'block';
            btnPdfContainer.style.display = 'block';
            return;
        }

        // Cálculo da porcentagem de validade restante
        const percentualRestante = (vidaUtilRestante / vidaUtilTotal) * 100;

        resultadoDiv.style.display = 'block';

        if (percentualRestante >= 70) {
            resultadoDiv.className = 'verde';
            resultadoDiv.innerHTML = `Dentro da validade (${percentualRestante.toFixed(2)}% restante). Aceitar material.`;
            btnPdfContainer.style.display = 'none';
        } else {
            resultadoDiv.className = 'vermelho';
            resultadoDiv.innerHTML = `Fora dos 70% de validade (${percentualRestante.toFixed(2)}% restante). Recusar material.`;
            btnPdfContainer.style.display = 'block';
        }
    }

    function gerarPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        // Cabeçalho do PDF
        doc.setFont("helvetica", "bold");
        doc.setFontSize(14);
        doc.text("** RECUSA DE MATERIAL NÃO ATINGINDO O ESTIPULADOS CONTRATUAL **", 14, 20, { maxWidth: 180 });

        // Corpo do arquivo
        doc.setFont("helvetica", "normal");
        doc.setFontSize(12);
        const textoCorpo = "Este material não atingiu os 70% de validade estipulados no ato do contrato entre Transpetro e o fornecedor em questão, desta forma não podemos aceitar o material. E estamos devolvendo o mesmo.\n\nObrigado.";
        
        doc.text(textoCorpo, 14, 40, { maxWidth: 180 });

        // Campos finais (Nome, Data, Matrícula)
        const yPos = 90;
        doc.text("Nome: _______________________________________", 14, yPos);
        doc.text("Data: ____/____/________", 14, yPos + 15);
        doc.text("Matrícula: ___________________", 14, yPos + 30);

        // Salvar o arquivo PDF
        doc.save("recusa_material.pdf");
    }
</script>

</body>
</html>
